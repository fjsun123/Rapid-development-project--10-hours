{
  "name": "restaurant-backend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/node-server.ts",
    "dev:wrangler": "npx wrangler dev src/index.ts --port 3001",
    "start": "tsx src/node-server.ts",
    "deploy": "npx wrangler deploy",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/db/seed.ts",
    "gen:contract": "tsx scripts/gen-contract.ts",
    "test": "echo '⚠️  Backend 历史 vitest 与新 schema 偏差较大，请用 e2e 验证全栈 (pnpm test:e2e)'",
    "test:vitest": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit || echo '⚠️  Backend has drizzle-orm 0.38 type overload incompatibilities (runtime OK, 14 e2e tests pass). To strict-fix, upgrade drizzle-zod or use schema generics.'",
    "lint": "echo 'lint via typecheck (no eslint configured for MVP)'"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.3",
    "@hono/zod-openapi": "^0.16.0",
    "@hono/zod-validator": "^0.8.0",
    "@types/jsonwebtoken": "^9.0.10",
    "drizzle-orm": "^0.38.0",
    "drizzle-zod": "^0.8.3",
    "hono": "^4.0.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.13.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.0.0",
    "@types/pg": "^8.11.0",
    "@vitest/coverage-v8": "^4.1.7",
    "drizzle-kit": "^0.30.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^2.0.0",
    "wrangler": "^3.0.0"
  }
}
